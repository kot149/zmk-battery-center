{
  "name": "zmk-battery-center",
  "version": "0.11.0",
  "private": true,
  "homepage": "https://github.com/kot149/zmk-battery-center",
  "bugs": "https://github.com/kot149/zmk-battery-center/issues",
  "license": "MIT",
  "author": "kot149",
  "repository": "https://github.com/kot149/zmk-battery-center",
  "type": "module",
  "scripts": {
    "dev": "bun tauri dev",
    "dev:frontend": "vite",
    "build:ui": "tsc && vite build",
    "build:app": "bun tauri build --no-bundle",
    "with:test-data": "bun scripts/with_dev_data_dir.ts",
    "test:app": "bun run build:app && bun run with:test-data bun scripts/smoke_launch_built_app.ts",
    "build": "tauri build",
    "preview": "vite preview",
    "test": "bun run test:frontend && bun run test:rust",
    "test:frontend": "bun run with:test-data vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "bun run e2e",
    "e2e": "bun run with:test-data playwright test",
    "e2e:install": "playwright install chromium",
    "tauri": "tauri",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "cargo-check": "(cd src-tauri && cargo check)",
    "check-versions": "bun scripts/verify_versions.ts",
    "check-licenses": "bun scripts/check_licenses.ts",
    "generate-licenses": "bun scripts/generate_licenses.ts",
    "bump-version": "bun scripts/bump_up.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-log": "~2.9.0",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-positioner": "~2.3.3",
    "@tauri-apps/plugin-store": "~2.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "license-checker": "^25.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "shadcn": "^4.19.0",
    "spdx-license-list": "^6.12.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
