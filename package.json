{
  "name": "zmk-battery-center",
  "version": "0.12.0",
  "private": true,
  "homepage": "https://github.com/kot149/zmk-battery-center",
  "bugs": "https://github.com/kot149/zmk-battery-center/issues",
  "license": "MIT",
  "author": "kot149",
  "repository": "https://github.com/kot149/zmk-battery-center",
  "type": "module",
  "scripts": {
    "dev": "bun tauri dev",
    "dev:frontend": "vite",
    "build:ui": "tsc && vite build",
    "build:app": "bun tauri build --no-bundle",
    "with:test-data": "bun scripts/with_dev_data_dir.ts",
    "test:app": "bun run build:app && bun run with:test-data bun scripts/smoke_launch_built_app.ts",
    "build": "tauri build",
    "preview": "vite preview",
    "preview:update": "bun run build:ui && bun scripts/preview_update.ts",
    "test": "bun run test:frontend && bun run test:rust",
    "test:frontend": "bun run with:test-data vitest run",
    "test:rust": "cargo test",
    "test:e2e": "bun run e2e",
    "e2e": "bun run with:test-data playwright test",
    "e2e:install": "playwright install chromium",
    "tauri": "tauri",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "cargo-check": "cargo check",
    "check-versions": "bun scripts/verify_versions.ts",
    "check-licenses": "bun scripts/check_licenses.ts",
    "generate-licenses": "bun scripts/generate_licenses.ts",
    "bump-version": "bun scripts/bump_up.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-log": "~2.10.0",
    "@tauri-apps/plugin-notification": "~2.5.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-positioner": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "license-checker": "^25.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "shadcn": "^4.21.1",
    "spdx-license-list": "^6.12.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
